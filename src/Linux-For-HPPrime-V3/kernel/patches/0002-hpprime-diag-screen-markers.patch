+/*
+ * 40_Build screen diagnostics (2026-11-18): no UART wired. Paint 24 px stripes in the TOP band of
+ * the BOOT1 framebuffer (phys 0x31F80000, 320x240 x8r8g8b8, excluded from RAM by ATAG_MEM).
+ *   top slot 2 cyan   = init_machine reached (early kernel boot, MMU/IRQ/timer OK)
+ *   top slot 3 yellow = late_initcall reached (driver registration done)
+ */
+static void hpp_diag_top(unsigned int slot, unsigned int rgb)
+{
+	u32 __iomem *fb = ioremap(0x31F80000, 320 * 240 * 4);
+	unsigned int x, y, x0 = (slot - 1) * 53;
+
+	if (!fb)
+		return;
+	for (y = 0; y < 24; y++)
+		for (x = x0; x < x0 + 49 && x < 320; x++)
+			writel(rgb, fb + x + y * 320);
+	iounmap(fb);
+}
+
+static int __init hpp_diag_late(void)
+{
+	if (machine_is_hpprime())
+		hpp_diag_top(3, 0x00FFFF00);
+	return 0;
+}
+late_initcall(hpp_diag_late);
+
