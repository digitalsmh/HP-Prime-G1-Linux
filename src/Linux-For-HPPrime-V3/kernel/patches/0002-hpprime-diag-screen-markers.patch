diff -ruN a/include/linux/hpp_diag.h b/include/linux/hpp_diag.h
--- a/include/linux/hpp_diag.h	1970-01-01 09:00:00.000000000 +0900
+++ b/include/linux/hpp_diag.h	2026-11-18 15:56:37.394470728 +0900
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 40_Build screen diagnostics (2026-11-18). No UART is wired on the HP Prime, so boot progress is
+ * painted into the BOOT1 framebuffer (phys 0x31F80000, 320x240 x8r8g8b8).
+ * Fixed VA 0xF9080000 -> PA 0x31F80000: mapped by head.S (1 MiB section, until paging_init) and by
+ * smdk2416_iodesc (after paging_init). Usable from start_kernel on, except inside paging_init.
+ * row 0 = top band (decompressor / machine), row 1 = second band, row 2 = third band.
+ */
+#ifndef _LINUX_HPP_DIAG_H
+#define _LINUX_HPP_DIAG_H
+
+#define HPP_DIAG_VA	0xF9080000UL
+#define HPP_DIAG_PA	0x31F80000UL
+
+static inline void hpp_diag(unsigned int row, unsigned int slot, unsigned int rgb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)HPP_DIAG_VA;
+	unsigned int x, y, x0 = (slot - 1) * 53, y0 = row * 30;
+
+	for (y = y0; y < y0 + 24; y++)
+		for (x = x0; x < x0 + 49 && x < 320; x++)
+			fb[x + y * 320] = rgb;
+}
+#endif
