@@ -134,6 +134,22 @@
 extern int do_decompress(u8 *input, int len, u8 *output, void (*error)(char *x));
 
 
+/*
+ * 40_Build screen diagnostics (2026-11-18): no UART is wired, so paint a 24 px stripe in the
+ * TOP band of the BOOT1 framebuffer (phys 0x31F80000, 320x240 x8r8g8b8). The decompressor runs
+ * with a 1:1 mapping, so the physical address is usable here.
+ *   top slot 1 green = decompression OK, red = decompressor error
+ */
+static void hpp_diag_top(unsigned int slot, unsigned int rgb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x31F80000;
+	unsigned int x, y, x0 = (slot - 1) * 53;
+
+	for (y = 0; y < 24; y++)
+		for (x = x0; x < x0 + 49 && x < 320; x++)
+			fb[x + y * 320] = rgb;
+}
+
 void
 decompress_kernel(unsigned long output_start, unsigned long free_mem_ptr_p,
 		unsigned long free_mem_ptr_end_p,
@@ -154,10 +170,13 @@
 	putstr("Uncompressing Linux...");
 	ret = do_decompress(input_data, input_data_end - input_data,
 			    output_data, error);
-	if (ret)
+	if (ret) {
+		hpp_diag_top(1, 0x00FF0000);
 		error("decompressor returned an error");
-	else
+	} else {
+		hpp_diag_top(1, 0x0000FF00);
 		putstr(" done, booting the kernel.\n");
+	}
 }
 
