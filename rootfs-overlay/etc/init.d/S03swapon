#!/bin/sh
# Permanent zram0 compressed RAM swap (12 MiB) — avoids mtdblock NAND swap livelock & JFFS2 corruption.
case "$1" in
  start)
    if ! grep -q "^/dev/zram0 " /proc/swaps 2>/dev/null; then
      echo 1 > /sys/block/zram0/reset 2>/dev/null || true
      echo 12582912 > /sys/block/zram0/disksize && mkswap /dev/zram0 >/dev/null && swapon /dev/zram0 \
        && echo "swap on /dev/zram0 (12 MiB) OK" || echo "zram0 swap FAIL"
    else
      echo "zram0 swap already on"
    fi
    if grep -q "/dev/loop0" /proc/swaps 2>/dev/null; then
      sync
      echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
      swapoff /dev/loop0 2>/dev/null || true
      losetup -d /dev/loop0 2>/dev/null || true
    fi
    ;;
  stop)
    swapoff /dev/zram0 2>/dev/null || true
    swapoff /dev/loop0 2>/dev/null || true
    losetup -d /dev/loop0 2>/dev/null || true
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
